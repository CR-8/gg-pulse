# Copy to .env.local and fill in. Never commit real values.

# --- Required ---------------------------------------------------------------
# Standalone: its own database. Integrated with GG-ops: GG-ops's database (docs/INTEGRATION-GG-OPS.md).
MONGODB_URI=mongodb://127.0.0.1:27017/gg-pulse
# Session signing/encryption key, also keys email-verification code hashes. Generate: npx auth secret
AUTH_SECRET=
# Public URL, used in invite links and emails. Required in production.
APP_URL=http://localhost:3000
# Needed when self-hosting behind a proxy (not on Vercel).
AUTH_TRUST_HOST=true

# --- Optional sign-in providers (a button appears when both values are set) --
# Google: redirect URI <APP_URL>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# GitHub OAuth app (not the GitHub App used for repositories): callback <APP_URL>/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# --- Email (required in production; dev logs messages to the console) ------
EMAIL_FROM="gg-pulse <noreply@example.com>"
# Resend is used when its key is set...
RESEND_API_KEY=
# ...otherwise SMTP when all three are set.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
